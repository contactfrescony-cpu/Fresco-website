NODE_ENV=production
PORT=8000
HOST=0.0.0.0
TRUST_PROXY=true

# Contact form email (Contact page -> "Send enquiry"; each enquiry is also saved for the back-office Enquiries page).
# Use the SMTP settings of the mailbox that sends the enquiries, e.g.
#   Google Workspace: smtp.gmail.com, port 465, SMTP_SECURE=true, an App Password
#   Microsoft 365:    smtp.office365.com, port 587, SMTP_SECURE=false
#   Zoho Mail:        smtp.zoho.com, port 465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_TO=info@frescony.uk
# Must be an address the SMTP account is allowed to send from (defaults to SMTP_USER).
CONTACT_FROM=

# MySQL back-office database (admin login and roles). Run "npm run db:setup" once after filling these in.
DB_HOST=
DB_PORT=3306
DB_NAME=fresco_ny
DB_USER=
DB_PASSWORD=
# Time zone used when showing dates (reports are in IST). Data is stored in UTC.
DB_TIMEZONE=+05:30
# When the database is reached over the internet (e.g. website on Hostinger, MySQL on your own server):
# DB_HOST is a plain name or IP (no https://), e.g. db.example.com. Turn on encryption:
DB_SSL=false
# Optional: path to the MySQL server's ca.pem, so the website also checks it is really your server.
DB_SSL_CA=

# Google Drive upload bridge (contributor "Upload Photos" page -> "Unprocessed Garment Images").
# Set up google/drive-upload.gs as an Apps Script web app first; then run "npm run drive:check".
DRIVE_UPLOAD_URL=
# A long random string; must equal the script's UPLOAD_SECRET property.
DRIVE_UPLOAD_SECRET=

# Google Sheet copy of every Contact-page enquiry. Set up google/enquiries-sheet.gs as an Apps Script web app
# inside the Sheet first; then run "npm run sheets:check".
SHEETS_WEBHOOK_URL=
# A long random string; must equal the script's SHEET_SECRET property.
SHEETS_WEBHOOK_SECRET=

# Google Analytics 4 (back-office Analytics page). The site's tracking tag is built in; these settings let the
# server READ the reports. GA4_PROPERTY_ID is the numeric property ID (GA4 Admin -> Property details), not "G-...".
# GA4_KEY_FILE is a Google Cloud service-account JSON key (never commit it; google/*-key.json is gitignored).
# Add that service account's email as a Viewer in GA4 Admin -> Property access management.
GA4_PROPERTY_ID=
GA4_KEY_FILE=google/ga4-key.json

# Daily analytics email (recipients and send time are set on the back-office Analytics page; uses the SMTP settings above).
# Time zone for the send time and for "yesterday" in the report.
REPORT_TIME_ZONE=Asia/Kolkata
# Public address of the website, used for the links in the analytics email and the "New enquiry" email.
SITE_URL=https://frescony.uk

# Insights page blogs (Google Drive: one folder per tab, max 20 blog .json files each).
# Set up google/insights-feed.gs as an Apps Script web app first; then run "npm run insights:check".
INSIGHTS_FEED_URL=
# A long random string; must equal the script's INSIGHTS_SECRET property.
INSIGHTS_FEED_SECRET=
