NODE_ENV=production
PORT=8000
HOST=0.0.0.0
TRUST_PROXY=true

# Contact form email (Contact page -> "Send project email").
# Use the SMTP settings of the mailbox that sends the enquiries, e.g.
#   Google Workspace: smtp.gmail.com, port 465, SMTP_SECURE=true, an App Password
#   Microsoft 365:    smtp.office365.com, port 587, SMTP_SECURE=false
#   Zoho Mail:        smtp.zoho.com, port 465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_TO=info@frescony.uk
# Must be an address the SMTP account is allowed to send from (defaults to SMTP_USER).
CONTACT_FROM=

# MySQL back-office database (admin login and roles). Run "npm run db:setup" once after filling these in.
DB_HOST=
DB_PORT=3306
DB_NAME=fresco_ny
DB_USER=
DB_PASSWORD=
# Time zone used when showing dates (reports are in IST). Data is stored in UTC.
DB_TIMEZONE=+05:30

# Google Drive upload bridge (contributor "Upload Photos" page -> "Unprocessed Garment Images").
# Set up google/drive-upload.gs as an Apps Script web app first; then run "npm run drive:check".
DRIVE_UPLOAD_URL=
# A long random string; must equal the script's UPLOAD_SECRET property.
DRIVE_UPLOAD_SECRET=
